{
  "name": "fundsroom-pern-erp",
  "version": "1.0.0",
  "description": "PERN Stack ERP Application - Manufacturing & Supply Chain",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "test:coverage": "npm --prefix backend run test:coverage",
    "db:setup": "npm --prefix backend run db:setup",
    "db:migrate": "npm --prefix backend run migrate",
    "db:seed": "npm --prefix backend run seed",
    "build": "npm --prefix frontend run build"
  },
