# ==============================================================================
# Fundsroom ERP - Environment Configuration Template
# Copy this file to backend/.env and update with your local PostgreSQL credentials
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Either provide DATABASE_URL or individual PG* variables
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/erp_db
PGUSER=postgres
PGPASSWORD=your_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=erp_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_string_32_chars_min
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173
